# Copy to .env and fill in. Never commit .env.

# Admin page login (http://<vm-ip>:3000/)
ADMIN_USER=daniel
ADMIN_PASS=change-me-to-something-long

# Network
PORT=3000
HOST=0.0.0.0
# Address phones will open. Used to show the NFC tag URLs on the admin page.
# Use the VM's LAN IP (or a Tailscale IP if you want to tap away from home).
BASE_URL=http://192.168.1.50:3000

# Timezone for "today", deadlines and weekdays
TZ_NAME=America/New_York

# Pushover (https://pushover.net). One application token for the whole app.
PUSHOVER_APP_TOKEN=

# Set to 1 to print alerts to the console instead of sending them
DRY_RUN=0

# SQLite file (created on first run)
DB_FILE=./data/chores.db
